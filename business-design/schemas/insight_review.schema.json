{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MarketInsightReview",
  "description": "03e Report consultant 对研究报告与 market_insight.json 的独立输入质量评审契约。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "research_report_path",
    "market_insight_path",
    "report_length",
    "research_coverage",
    "data_integrity",
    "business_design_readiness",
    "revision_route",
    "issues",
    "review_summary"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "status": {
      "type": "string",
      "enum": ["PASS", "REVISE"]
    },
    "research_report_path": {
      "$ref": "#/definitions/nonEmptyString"
    },
    "market_insight_path": {
      "$ref": "#/definitions/nonEmptyString"
    },
    "report_length": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audit_path", "counting_method", "effective_count", "minimum", "maximum", "passed"],
      "properties": {
        "audit_path": {"$ref": "#/definitions/nonEmptyString"},
        "counting_method": {"$ref": "#/definitions/nonEmptyString"},
        "effective_count": {"type": "integer", "minimum": 0},
        "minimum": {"type": "integer", "const": 10000},
        "maximum": {"type": "integer", "const": 15000},
        "passed": {"type": "boolean"}
      }
    },
    "research_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value_chain_metrics_complete",
        "players_and_competition_complete",
        "business_models_complete",
        "trends_policy_competitors_complete",
        "company_specific_inputs_sufficient",
        "profit_model_inputs_sufficient",
        "data_gaps_disclosed"
      ],
      "properties": {
        "value_chain_metrics_complete": {"type": "boolean"},
        "players_and_competition_complete": {"type": "boolean"},
        "business_models_complete": {"type": "boolean"},
        "trends_policy_competitors_complete": {"type": "boolean"},
        "company_specific_inputs_sufficient": {"type": "boolean"},
        "profit_model_inputs_sufficient": {"type": "boolean"},
        "data_gaps_disclosed": {"type": "boolean"}
      }
    },
    "data_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_quantitative_claims_traceable",
        "verified_claims_supported",
        "estimates_labeled_and_reproducible",
        "facts_estimates_assumptions_separated",
        "suspected_fabrications",
        "unsupported_claims"
      ],
      "properties": {
        "all_quantitative_claims_traceable": {"type": "boolean"},
        "verified_claims_supported": {"type": "boolean"},
        "estimates_labeled_and_reproducible": {"type": "boolean"},
        "facts_estimates_assumptions_separated": {"type": "boolean"},
        "suspected_fabrications": {
          "type": "array",
          "items": {"$ref": "#/definitions/nonEmptyString"}
        },
        "unsupported_claims": {
          "type": "array",
          "items": {"$ref": "#/definitions/nonEmptyString"}
        }
      }
    },
    "business_design_readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market_attractiveness_scoring_ready",
        "customer_selection_ready",
        "value_proposition_ready",
        "profit_model_design_ready",
        "limitations_are_actionable",
        "summary"
      ],
      "properties": {
        "market_attractiveness_scoring_ready": {"type": "boolean"},
        "customer_selection_ready": {"type": "boolean"},
        "value_proposition_ready": {"type": "boolean"},
        "profit_model_design_ready": {"type": "boolean"},
        "limitations_are_actionable": {"type": "boolean"},
        "summary": {"$ref": "#/definitions/nonEmptyString"}
      }
    },
    "revision_route": {
      "type": "string",
      "enum": ["none", "supplement_research", "restructure_market_insight"]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "severity", "issue", "required_action"],
        "properties": {
          "category": {
            "type": "string",
            "enum": ["length", "coverage", "source", "fabrication_risk", "estimation", "consistency", "design_readiness"]
          },
          "severity": {
            "type": "string",
            "enum": ["blocking", "major", "minor"]
          },
          "issue": {"$ref": "#/definitions/nonEmptyString"},
          "required_action": {"$ref": "#/definitions/nonEmptyString"}
        }
      }
    },
    "review_summary": {
      "$ref": "#/definitions/nonEmptyString"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "PASS"}}},
      "then": {
        "properties": {
          "revision_route": {"const": "none"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "REVISE"}}},
      "then": {
        "properties": {
          "revision_route": {"enum": ["supplement_research", "restructure_market_insight"]},
          "issues": {"minItems": 1}
        }
      }
    }
  ],
  "definitions": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    }
  }
}

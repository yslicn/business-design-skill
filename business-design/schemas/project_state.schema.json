{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BusinessDesignProjectState",
  "description": "业务设计状态；1.0–1.2 保持旧版兼容，1.3 默认核心为分析 JSON、正文 MD、DOCX 和内容质量报告。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_name",
    "run_mode",
    "run_status",
    "current_step",
    "stages",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3"
      ]
    },
    "project_name": {
      "type": "string",
      "minLength": 1
    },
    "run_mode": {
      "type": "string",
      "enum": [
        "full",
        "resume",
        "research_provided",
        "design_provided",
        "ppt_provided",
        "core_resume"
      ]
    },
    "run_status": {
      "type": "string",
      "enum": [
        "active",
        "waiting_for_user",
        "blocked",
        "completed"
      ]
    },
    "current_step": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_01",
        "step_02",
        "step_03",
        "step_04",
        "step_05",
        "step_06",
        "step_07"
      ],
      "properties": {
        "step_01": {
          "$ref": "#/definitions/stageState"
        },
        "step_02": {
          "$ref": "#/definitions/stageState"
        },
        "step_03": {
          "$ref": "#/definitions/stageState"
        },
        "step_04": {
          "$ref": "#/definitions/stageState"
        },
        "step_05": {
          "$ref": "#/definitions/stageState"
        },
        "step_06": {
          "$ref": "#/definitions/stageState"
        },
        "step_07": {
          "$ref": "#/definitions/stageState"
        },
        "step_08": {
          "$ref": "#/definitions/stageState"
        }
      }
    },
    "visual_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_round",
        "max_rounds",
        "pages_reviewed",
        "pages_to_recheck",
        "remaining_issues"
      ],
      "properties": {
        "current_round": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "max_rounds": {
          "type": "integer",
          "const": 3
        },
        "pages_reviewed": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "pages_to_recheck": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "remaining_issues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "core_status": {
      "type": "string",
      "enum": [
        "in_progress",
        "needs_revision",
        "waiting_for_user",
        "completed",
        "blocked"
      ]
    },
    "core_artifacts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/artifactCheck"
      }
    },
    "optional_exports": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/optionalExport"
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coverage_inventory": {
          "$ref": "#/definitions/artifactCheck"
        },
        "slide_handoff_preflight": {
          "$ref": "#/definitions/artifactCheck"
        },
        "downstream": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "path"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "last_real_run_at": {
          "type": "string",
          "minLength": 1
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "schema_version"
        ],
        "properties": {
          "schema_version": {
            "enum": [
              "1.1",
              "1.2",
              "1.3"
            ]
          }
        }
      },
      "then": {
        "required": [
          "core_status",
          "core_artifacts",
          "optional_exports"
        ]
      }
    },
    {
      "if": {
        "required": [
          "schema_version"
        ],
        "properties": {
          "schema_version": {
            "const": "1.2"
          }
        }
      },
      "then": {
        "properties": {
          "core_artifacts": {
            "required": [
              "business_design.json",
              "business_design.md",
              "business_design.html",
              "business_design.docx",
              "content_quality_report.json"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "schema_version"
        ],
        "properties": {
          "schema_version": {
            "const": "1.3"
          }
        }
      },
      "then": {
        "properties": {
          "core_artifacts": {
            "required": [
              "business_design.json",
              "business_design.md",
              "business_design.docx",
              "content_quality_report.json"
            ]
          }
        }
      }
    }
  ],
  "definitions": {
    "stageState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reused",
        "revision_count",
        "artifacts",
        "validation_notes"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "in_progress",
            "passed",
            "needs_revision",
            "waiting_for_user",
            "blocked"
          ]
        },
        "reused": {
          "type": "boolean"
        },
        "revision_count": {
          "type": "integer",
          "minimum": 0
        },
        "artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validation_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "artifactCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "status"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "PENDING"
          ]
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "updated_at": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "optionalExport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "renderer",
        "status",
        "artifacts",
        "issues"
      ],
      "properties": {
        "format": {
          "type": "string",
          "minLength": 1
        },
        "renderer": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "not_requested",
            "pending",
            "passed",
            "failed"
          ]
        },
        "artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
